{
  "name": "joeweh.github.io",
  "version": "1.0.0",
  "description": "My personal portfolio website showcasing projects, experience, and contact information.",
  "homepage": "https://joeyqsa.dev",
  "author": "Joseph Siracusa <joey@joeyqsa.dev>",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Joeweh/Joeweh.github.io.git"
  },
  "bugs": {
    "url": "https://github.com/Joeweh/Joeweh.github.io/issues"
  },
  "type": "commonjs",
  "scripts": {
    "build": "eleventy",
    "dev": "eleventy --serve",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "links": "linkinator _site --recurse --skip '^https'",
    "links:all": "linkinator _site --recurse --retry --retry-errors"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@shopify/prettier-plugin-liquid": "^1.11.0",
    "linkinator": "^8.1.0",
    "prettier": "^3.9.6"
  }
}
