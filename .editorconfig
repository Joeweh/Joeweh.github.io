root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

[*.{json,yml,yaml,md,liquid}]
indent_size = 2

# Markdown uses trailing spaces for hard line breaks
[*.md]
trim_trailing_whitespace = false

[LICENSE]
indent_size = unset
max_line_length = unset
