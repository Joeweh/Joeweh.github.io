<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Joseph Siracusa — Software Engineer, Northeastern University</title>
    <meta
      name="description"
      content="Joseph Siracusa — SWE research intern at Khoury College of CS and CS student at Northeastern University. Projects in mobile, web, and systems software."
    >

    <link rel="canonical" href="https://joeyqsa.dev">

    <!-- Open Graph -->
    <meta property="og:site_name" content="joeyqsa.dev">
    <meta property="og:title" content="Joseph Siracusa">
    <meta
      property="og:description"
      content="SWE research intern at Khoury College of CS. CS at Northeastern"
    >
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://joeyqsa.dev">
    <meta property="og:image" content="https://joeyqsa.dev/assets/images/og-image.png">

    <!-- Twitter/X -->
    <meta name="twitter:card" content="summary_large_image">

    <!-- Fonts & Styles -->
    <link
      rel="preload"
      href="/assets/fonts/Inter/regular-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    >
    <link
      rel="preload"
      href="/assets/fonts/Inter/bold-700.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    >
    <link rel="stylesheet" href="/styles.css">

    <!-- Favicons -->
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/assets/images/favicons/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/assets/images/favicons/apple-touch-favicon.png">

    <!-- Structured Data (for SEO) -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "ProfilePage",
        "mainEntity": {
          "@type": "Person",
          "name": "Joseph Siracusa",
          "url": "https://joeyqsa.dev",
          "image": "https://joeyqsa.dev/assets/images/og-image.png",
          "jobTitle": "Software Engineering Research Intern",
          "description": "SWE research intern at Khoury College of CS and CS student at Northeastern University.",
          "email": "mailto:joey@joeyqsa.dev",
          "sameAs": [
            "https://github.com/Joeweh",
            "https://www.linkedin.com/in/joseph-siracusa",
            "https://devpost.com/Joeweh"
          ],
          "affiliation": {
            "@type": "CollegeOrUniversity",
            "name": "Northeastern University"
          }
        }
      }
    </script>
  </head>
  <body>
    {% include 'icons.liquid' %}

    <header>
      <h1>Joseph Siracusa</h1>
      <p class="headline">
        <span>
          SWE Research Intern @
          <a
            class="text-link"
            href="https://www.khoury.northeastern.edu/current-masters-and-certificate-students/khoury-research-apprenticeship/"
            target="_blank"
            rel="noopener noreferrer"
            >Khoury College of CS</a
          >
        </span>
        <span>
          Prev SWE Intern @
          <a
            class="text-link"
            href="https://nunext.dev/"
            target="_blank"
            rel="noopener noreferrer"
            >NExT Consulting</a
          >
        </span>
        <span>
          CS @
          <a
            class="text-link"
            href="https://www.khoury.northeastern.edu/"
            target="_blank"
            rel="noopener noreferrer"
            >Northeastern University</a
          >
        </span>
      </p>

      <nav aria-label="Email, social links, and resume">
        <div class="social-container">
          {% for social in socials %}
            <a
              class="social-link social-link-{{ social.icon }}"
              href="{{ social.href }}"
              title="{{ social.title }}"
              aria-label="{{ social.aria }}"
              {% if social.external %}
                target="_blank" rel="noopener noreferrer"
              {% endif %}
            >
              <svg width="36" height="36" fill="currentColor" aria-hidden="true">
                <use href="#icon-{{ social.icon }}"></use>
              </svg>
            </a>
          {% endfor %}
        </div>

        <a
          class="resume-link"
          href="/assets/documents/ResumeJosephSiracusa.pdf"
          target="_blank"
          rel="noopener noreferrer"
          >Resume (PDF)</a
        >
      </nav>
    </header>

    <main>
      <section>
        <h2>Projects</h2>
        <div class="projects-grid">
          {% for project in projects %}
            <article class="project-card">
              {% if project.badge %}
                <div class="project-media">
                  <img
                    class="project-image"
                    src="{{ project.image }}"
                    alt="{{ project.alt }}"
                    {% if project.fetchpriority %}
                      fetchpriority="{{ project.fetchpriority }}"
                    {% endif -%}
                    {% if project.loading %}
                      loading="{{ project.loading }}"
                    {% endif %}
                  >
                  <span class="project-badge{% if project.badge.tier %} project-badge--{{ project.badge.tier }}{% endif %}">
                    <svg fill="currentColor" aria-hidden="true">
                      <use href="#icon-trophy"></use>
                    </svg>
                    {{ project.badge.label }}
                  </span>
                </div>
              {% else %}
                <img
                  class="project-image"
                  src="{{ project.image }}"
                  alt="{{ project.alt }}"
                  {% if project.loading %}
                    loading="{{ project.loading }}"
                  {% endif %}
                >
              {% endif %}
              <div class="project-content">
                <div class="project-header">
                  <h3 class="project-title">{{ project.title }}</h3>
                  <div class="project-links">
                    {% for link in project.links %}
                      <a
                        class="social-link social-link-{{ link.icon }}"
                        href="{{ link.href }}"
                        target="_blank"
                        title="{{ link.title }}"
                        aria-label="{{ link.aria }}"
                        rel="noopener noreferrer"
                      >
                        <svg width="24" height="24" fill="currentColor" aria-hidden="true">
                          <use href="#icon-{{ link.icon }}"></use>
                        </svg>
                      </a>
                    {% endfor %}
                  </div>
                </div>
                <p class="project-description">{{ project.description }}</p>
              </div>
            </article>
          {% endfor %}
        </div>
      </section>
    </main>

    <footer>
      <p>&copy; {{ site.year }} Joseph Siracusa</p>
    </footer>
  </body>
</html>
